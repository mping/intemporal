;; shadow-cljs configuration
{:deps {:aliases [:cljs :dev :doc]}
 :dev-http {8000 "public"}
 :builds {:doc {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :compiler-options {:infer-externs true
                                   :optimizations :simple}
                :modules {:shared {:entries []}
                          :main     {:init-fn intemporal.doc/init
                                     :depends-on #{:shared}}
                          :provision-saga {:init-fn intemporal.provision-saga/init
                                           :depends-on #{:shared}}
                          :provision-automata {:init-fn intemporal.provision-automata/init
                                               :depends-on #{:shared}}
                          :child-workflows {:init-fn intemporal.child-workflows/init
                                            :depends-on #{:shared}}}}

          :node {:target    :node-test
                 :output-to "target/tests.js"
                 :ns-regexp "intemporal\\.tests\\..*-test$"
                 :compiler-options {:source-map "true"}
                 :autorun   true}}}
