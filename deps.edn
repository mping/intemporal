{:paths      ["src" "resources"]
 :test-paths ["test"]

 :deps       {org.clojure/clojure                      {:mvn/version "1.12.1"}
              com.taoensso/telemere                    {:mvn/version "1.2.1"}
              com.github.steffan-westcott/clj-otel-api {:mvn/version "0.2.10"}
              ;; cljs (TODO test only?)
              funcool/promesa                          {:mvn/version "11.0.678"}
              ;;stuff
              net.cgrand/macrovich                     {:mvn/version "0.2.2"}}

 :aliases    {:nrepl {:extra-paths ["test"]
                      :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                      :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
        
              :dev   {:extra-paths ["dev" "test"]
                      :_jvm-opts   ["-Djdk.attach.allowAttachSelf"
                                    "-javaagent:./opentelemetry-javaagent.jar"
                                    "-Dotel.instrumentation.common.default-enabled=true"
                                    "-Dotel.javaagent.debug=false"
                                    "-Dotel.exporter.otlp.protocol=grpc"
                                    "-Dotel.exporter.otlp.endpoint=http://localhost:4317"
                                    "-Dotel.instrumentation.netty.enabled=false"
                                    "-Dotel.metrics.exporter=none"
                                    "-Dotel.logs.exporter=none"
                                    "-Dotel.javaagent.debug=false"
                                    "-Dotel.resource.attributes=service.name=intemporal"]

                      :extra-deps  {lambdaisland/kaocha                      {:mvn/version "1.91.1392"}
                                    lambdaisland/kaocha-cloverage            {:mvn/version "1.1.89"}
                                    lambdaisland/kaocha-junit-xml            {:mvn/version "1.17.101"}
                                    com.lambdaisland/kaocha-cljs             {:mvn/version "1.5.154"}
                                    ch.qos.logback/logback-classic           {:mvn/version "1.5.18"}
                                    tortue/spy                               {:mvn/version "2.15.0"}
                                    nubank/matcher-combinators               {:mvn/version "3.9.2"}
                                    com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                                    io.opentelemetry/opentelemetry-sdk-testing {:mvn/version "1.54.1"}
                                    nrepl/nrepl                              {:mvn/version "1.3.1"}}}
              :fdb   {:extra-deps {org.foundationdb/fdb-java {:mvn/version "7.3.62"}
                                   me.vedang/clj-fdb         {:mvn/version "0.3.0"}}}

              :jdbc  {:extra-deps {com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                                   org.postgresql/postgresql         {:mvn/version "42.7.7"}
                                   org.mariadb.jdbc/mariadb-java-client {:mvn/version "3.4.1"}
                                   hikari-cp/hikari-cp               {:mvn/version "3.3.0"}
                                   migratus/migratus                 {:mvn/version "1.6.4"}}}
              :doc   {:extra-paths ["doc"]}
              :cljs  {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}
                                   thheller/shadow-cljs      {:mvn/version "3.2.0"}
                                   hiccups/hiccups           {:mvn/version "0.3.0"}}}

              :build {:extra-paths ["build"]
                      :deps        {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
                      :ns-default  build}

              ;; These replace project source paths with tiny consumers and put
              ;; the built jar on the classpath, proving the artifact is usable
              ;; without accidentally falling back to src/.
              :jar-smoke-jvm
              {:replace-paths ["build/smoke/jvm"]
               :extra-deps {intemporal/intemporal {:local/root "target/intemporal.jar"}}
               :main-opts ["-m" "intemporal.build-smoke.jvm"]}

              :jar-smoke-cljs
              {:replace-paths ["build/smoke/cljs"]
               :extra-deps {intemporal/intemporal {:local/root "target/intemporal.jar"}
                            org.clojure/clojurescript {:mvn/version "1.12.42"}}
               :main-opts ["-m" "cljs.main" "-O" "simple" "-t" "node"
                           "-o" "target/jar-smoke.js"
                           "-c" "intemporal.build-smoke.cljs"]}

              ;; clojure.spec.check-asserts turns on the inline `intemporal.spec/check!`
              ;; assertions in every IStore implementation, so each existing test
              ;; namespace doubles as a store-conformance suite. Deliberately NOT set on
              ;; the :jepsen aliases below: that harness calls load-history in a tight
              ;; resume loop, and validating long histories would distort the very race
              ;; windows those tests exist to reproduce.
              :test  {:jvm-opts  ["--enable-native-access=ALL-UNNAMED"
                                  "-Dclojure.spec.check-asserts=true"]
                      :main-opts ["-m" "kaocha.runner"]}

              ;; Run the chaos harness against a live Postgres instance:
              ;;   clojure -X:dev:jdbc:jepsen intemporal.jepsen.runner/run
              :jepsen {:extra-paths ["test" "test/resources"]
                       :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
                       :main-opts   ["-m" "intemporal.jepsen.runner"]}

              ;; Entry point for forked worker JVMs launched by db.clj/fork!
              :jepsen-worker {:extra-paths ["test" "test/resources"]
                              :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}}}
